PORT=3000
JWT_SECRET=change-this-local-secret

# Production database. If set, the backend uses PostgreSQL instead of SQLite.
# DATABASE_URL=postgresql://postgres:password@host:5432/postgres

# Local/development SQLite fallback, used only when DATABASE_URL is not set.
DATABASE_PATH=./data/database.sqlite

# Production storage. If all Supabase values are set, uploads go to Supabase Storage.
# STORAGE_PROVIDER=supabase
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_STORAGE_BUCKET=roa-media

# CORS_ORIGINS=https://supratco.github.io,http://localhost:3000
